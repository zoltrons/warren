{
  "name": "warren",
  "version": "0.0.16",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "build:wasm": "bash tools/build-wasm.sh --simd",
    "build": "node tools/build.mjs",
    "watch": "node tools/build.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run typecheck && npm test && node tools/check-contrast.mjs",
    "test": "node --test --experimental-strip-types \"src/**/*.test.ts\"",
    "test:coverage": "node -e \"fs.mkdirSync('coverage',{recursive:true})\" && node --test --experimental-strip-types --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info \"src/**/*.test.ts\"",
    "test:fill": "node tools/smoke-fill.mjs",
    "test:e2e": "node --experimental-strip-types tests/e2e/run.ts",
    "test:passkeys": "node tools/smoke-passkeys.mjs",
    "size": "node tools/size-report.mjs --check",
    "sync-upstream": "node tools/sync-upstream.mjs",
    "test:biometric": "node tools/build.mjs --e2e && node tools/smoke-biometric.mjs"
  },
  "devDependencies": {
    "@faker-js/faker": "10.6.0",
    "@types/chrome": "0.3.7",
    "binaryen": "132.0.0",
    "esbuild": "0.28.2",
    "playwright-core": "1.65.0",
    "typescript": "7.0.2"
  }
}
